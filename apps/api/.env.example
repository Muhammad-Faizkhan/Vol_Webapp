NODE_ENV=development
PORT=4000

# Postgres connection. Locally: `npx prisma dev --name vol --detach` prints these URLs.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Only needed by `prisma migrate dev`; omit it when the database user may create databases.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
# `prisma dev` serves one connection at a time; more makes parallel requests fail with 500s.
# Leave unset for a regular Postgres server.
DATABASE_POOL_MAX=1

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""
CODE_PEPPER=""

# Comma-separated list of frontends allowed to call the API with cookies.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Used by `npm run db:seed` to create the first admin account.
SEED_ADMIN_EMAIL="admin@vol.local"
SEED_ADMIN_PASSWORD=""
